# ============================================================
# Moana Adventures — single source of truth for client + server
# Copy to .env and adjust per environment.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins for Socket.IO CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Client (must be prefixed VITE_ to be exposed to the browser) ---
VITE_SERVER_URL=http://localhost:3000
